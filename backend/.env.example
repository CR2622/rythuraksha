# RythuRaksha AI — Environment Configuration Example (Team 33)
PORT=8000
DATABASE_PATH=./rythuraksha.db

# Hugging Face Inference Token & Model
HF_TOKEN=your_huggingface_token_here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_FALLBACK_MODELS=Qwen/Qwen2.5-72B-Instruct,Qwen/Qwen2.5-7B-Instruct

# Open-Meteo Historical Weather API (No key required)
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
